TS_HOST=teamspeak
TS_QUERY_PORT=10022
TS_QUERY_USER=serveradmin
# This same value is passed to the TeamSpeak container as
# TSSERVER_QUERY_ADMIN_PASSWORD, so it must be set here before first startup.
TS_QUERY_PASSWORD=
TS_VOICE_PORT=9987
TS_SERVER_ID=1
TS_PUBLIC_ADDRESS=

DISCORD_TOKEN=
DISCORD_STATUS_CHANNEL_ID=
DISCORD_STATUS_CHANNEL_NAME=status
